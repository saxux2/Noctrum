PORT=8081
# Must be a replica set (Atlas, or `mongod --replSet rs0`): ledger writes use transactions.
MONGODB_URI=mongodb://localhost:27017/noctrum-vault?replicaSet=rs0
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
VAULT_ADDRESS=0x65877F6BFd3f2D293454658BCb290b112397Eeb5
POLICY_ENGINE_ADDRESS=0x60B04476b481B10Ea26877C2cb144d6599b3d3C3
TICKET_SIGNER_PRIVATE_KEY=                # address must equal NoctrumVault.ticketSigner
EIP712_NAME=NoctrumPrivateToken
EIP712_VERSION=0.0.1
START_BLOCK=68685729
LOG_RANGE=100
POLL_MS=2000
TICKET_TTL_SECONDS=3600
AUTH_WINDOW_SECONDS=300
# How often the vault-holdings invariant is checked (runs with the indexer)
INVARIANT_MS=60000
# Set to "false" to serve the API without running the Monad indexer
INDEXER_ENABLED=true
