# Foundry scripts + api-scripts. Copy to .env. See noctrum-docs/ENV_AND_CONFIG.md §4.
# Addresses: deployments/monad-testnet.json
PRIVATE_KEY=                       # 0x… deployer
PRIVATE_KEY_2=                     # 0x… second account (07 withdraw demo, api-scripts)
RPC_URL=https://testnet-rpc.monad.xyz
VAULT_ADDRESS=                     # NoctrumVault
TICKET_SIGNER_ADDRESS=             # for 00_DeployVault
TOKEN_ADDRESS=                     # token for scripts 03–07
POLICY_ENGINE_ADDRESS=             # proxy
MINT_TO=                           # optional
WITHDRAW_AMOUNT=                   # wei
TICKET=                            # 0x… 89-byte withdrawal ticket
NUSD_ADDRESS=
NETH_ADDRESS=
MONADSCAN_API_KEY=                 # etherscan-style verify (optional; sourcify needs none)

# api-scripts only
VAULT_API_URL=http://localhost:8081
