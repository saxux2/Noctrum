# Noctrum server (port 8080). Copy to .env. See noctrum-docs/ENV_AND_CONFIG.md §1.
PORT=8080
MONGODB_URI=mongodb://localhost:27017/noctrum
TOKEN_ADDRESS=                     # nUSD (required)
NETH_ADDRESS=                      # nETH
CRE_PUBLIC_KEY=                    # compressed secp256k1 hex (required)
CHAIN_ID=10143
EXTERNAL_API_URL=http://localhost:8081   # noctrum-vault-api
EXTERNAL_VAULT_ADDRESS=            # NoctrumVault
INTERNAL_API_KEY=                  # random 32+ chars; empty = internal routes open
POOL_PRIVATE_KEY=                  # optional; only exposes poolAddress on /health
ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
ETH_USD_FEED=0x639Fe6ab55C921f74e7fac1ee960C0B6293ba612

# scripts/*.ts only (manual flow tests)
RPC_URL=https://testnet-rpc.monad.xyz
PRIVATE_KEY=
LENDER_A_KEY=
LENDER_B_KEY=
BORROWER_KEY=
